# Copia este archivo a .env y completa los valores.
#
# Los encuentras en Supabase → Project Settings → API:
# - SUPABASE_URL: Project URL (https://xxxx.supabase.co)
# - SUPABASE_ANON_KEY: clave pública (publishable o anon)
#
# Nunca uses la clave service_role o sb_secret_... en una app Flutter.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica
